[gd_scene load_steps=3 format=3 uid="uid://dy0fr276q28uy"]

[sub_resource type="GDScript" id="GDScript_owemw"]
script/source = "extends Node2D
@export var min_y := 0.0
@export var max_y := 800.0
@export var min_scale := 0.7
@export var max_scale := 1.2
@export var character_scale := ''
@export var scene_id := ''

@onready var game = get_node(\"/root/Game\")

func _ready():
	GameState.current_scene = scene_id
	if GameState.first_time_on_the_train:
		GameState.first_time_on_the_train = false
	
	if GameState.dialogue_flags.has(\"start_race\"):
		var target = game.find_child(\"Biker\", true, false) 
		var target2 = game.find_child(\"biker\", true, false)
		if target:
			target.queue_free()
		if target2:
			target2.queue_free()
		
	if GameState.from_govan_hallway:
		GameState.from_govan_hallway = false
		var player = get_tree().get_current_scene().get_node(\"Player\")
		player.input_enabled = false
		var label = get_tree().get_current_scene().get_node(\"Player/Player/Label\")
		label.visible = true
		label.text = \"Huh - the whistling has stoppped now?!\"
		await Helpers.wait(2.0)
		label.visible = false
		label.text = \"\"
		player.input_enabled = true		
"

